<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- News sites occasionally redirect through http mid-chain; allow cleartext so WebView/HttpURLConnection can finish. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
